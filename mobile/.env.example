# Copy this file to .env and fill in your Supabase project's values.
# Find these in the Supabase dashboard: Project Settings -> API Keys.
# Never commit the real .env file or a secret key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The new "publishable" key (sb_publishable_...) — the direct replacement
# for the legacy anon key, safe to ship in the client. If your project only
# shows legacy keys, the `anon` key works exactly the same way here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional — Sentry error monitoring. The app runs without this; crashes
# just won't be reported until it's set. Use the DSN from the PitchIn
# project in the inteck Sentry org.
EXPO_PUBLIC_SENTRY_DSN=
