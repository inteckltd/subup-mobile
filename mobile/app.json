{
  "expo": {
    "name": "SubUp",
    "slug": "pitchin",
    "scheme": "subup",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FEFEFD",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inteck.subup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["whatsapp", "whatsapp-business"]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.inteck.subup",
      "adaptiveIcon": {
        "backgroundColor": "#032488",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withShareQueries",
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEFEFD"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "SubUp uses your photos for your profile picture and group cover images.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#032488"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "inteck",
          "project": "pitchin"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.inteck.pitchin",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fa7b272f-1273-4429-a238-04b60fe29dce"
      },
      "router": {}
    },
    "owner": "pitchin"
  }
}
